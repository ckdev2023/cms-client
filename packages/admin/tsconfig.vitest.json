{
  /*
   * 测试专用 project：admin 的测试此前不在任何 tsconfig 里
   * （tsconfig.app.json 的 exclude 是 src/**\/*.test.ts，tsconfig.node.json 只 include
   * vite.config.ts），实测 `vue-tsc -b --listFiles | grep -c '\.test\.ts'` = 0——
   * 即 typecheck 一个测试文件都不查。vitest 走 esbuild 只转译不查类型，`import type`
   * 会被直接剥掉，所以测试里的类型错误此前两道门禁都不响。本 project 补上这个缺口，
   * 已加入 tsconfig.json 的 references，`npm run typecheck` 现在覆盖测试。
   *
   * include 必须带 src/**\/*.d.ts：route-meta.d.ts 里的 `declare module "vue-router"`
   * 若不在本 project 内，RouteMeta 会退化成 {}，authGuard.ts 会报假错。
   */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    /* 测试用 node:fs / node:path 做源码断言，需要 node 类型 */
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test-support.ts",
    "vitest.setup.ts",
    "vitest.config.ts"
  ],
  /*
   * 唯一豁免：BUG-103 phase 筛选的整份 spec 是 describe.skip 的「未立项待启用」桩
   * （见该文件里的 eslint-disable no-restricted-syntax -- BUG-103 注释）。它按尚未实现的
   * API 书写（useCaseListModel.setPhase、CaseListParams.phase 均不存在），定义上无法通过
   * 类型检查。BUG-103 落地时应同步删除本行并取消 describe.skip。
   */
  "exclude": ["src/views/cases/model/useCaseListModel.phase-filter.test.ts"]
}
